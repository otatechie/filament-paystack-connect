{
    "name": "otatechie/filament-paystack-connect",
    "description": "A Filament admin panel for otatechie/laravel-paystack-connect: payments, refunds and sellers.",
    "keywords": [
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "paystack",
        "marketplace",
        "split-payments"
    ],
    "homepage": "https://github.com/otatechie/filament-paystack-connect",
    "license": "MIT",
    "authors": [
        {
            "name": "otatechie"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.8.3",
        "otatechie/laravel-paystack-connect": "^1.2",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "pestphp/pest-plugin-livewire": "^4.0||^5.0"
    },
    "autoload": {
        "psr-4": {
            "Otatechie\\FilamentPaystackConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Otatechie\\FilamentPaystackConnect\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Otatechie\\FilamentPaystackConnect\\FilamentPaystackConnectServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/otatechie/filament-paystack-connect/issues",
        "source": "https://github.com/otatechie/filament-paystack-connect"
    }
}
